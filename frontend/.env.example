# Copy to .env.local for local overrides. Only VITE_* variables reach the browser bundle,
# so never put secrets here.

# Spring Boot API origin, without a trailing slash (e.g. https://api.example.com).
# Leave empty in development: requests go to /api on the Vite dev server,
# which proxies them to http://localhost:8080 (see vite.config.ts).
VITE_API_BASE_URL=
